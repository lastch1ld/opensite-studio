# Reverse proxy + automatic TLS for self-hosted OpenSite Studio
# (docs/deployment.md "Reverse proxy for custom domains + TLS").
#
# Custom domains are added by users at runtime, not known when this file is
# written, so they're handled with on-demand TLS: Caddy asks the app's
# verify-ask endpoint before requesting a cert for any hostname that isn't
# explicitly listed below, and only proceeds on a 2xx (see
# app/api/domains/verify-ask/route.ts, which only allows a hostname that
# matches a Site.customDomain with customDomainVerified = true).
{
	on_demand_tls {
		ask http://web:3000/api/domains/verify-ask
	}
}

# APP_DOMAIN and its subdomains: a normal (non-on-demand) cert, since these
# hostnames are known ahead of time. Wildcard subdomains need a DNS-01
# challenge (a provider-specific Caddy module + API token), left as a
# deployment-specific choice — swap in your DNS provider's directive here.
# {$APP_DOMAIN}, *.{$APP_DOMAIN} {
# 	reverse_proxy web:3000
# }

# Any other hostname: only issued a cert if verify-ask allows it.
:443 {
	tls {
		on_demand
	}
	reverse_proxy web:3000
}
