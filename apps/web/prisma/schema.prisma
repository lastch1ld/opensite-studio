generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  image         String?
  role          String    @default("OWNER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?

  accounts    Account[]
  sessions    Session[]
  sites       Site[]
  memberships Membership[]
  revisions   Revision[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  subdomain String   @unique
  // Single custom-domain + verified flag (docs/renderer.md "Custom domain
  // verification + TLS") — deliberately not the doc's originally-sketched
  // multi-host-per-site `Domain` table, out of scope for this pass.
  // customDomainVerifyToken is the value the owner must publish in a
  // `_opensite-verify.{customDomain}` TXT record; customDomainVerified only
  // flips true after a server-side DNS lookup confirms it, and is the sole
  // gate lib/resolveSite.ts uses before serving content on that host.
  customDomain            String?  @unique
  customDomainVerified    Boolean  @default(false)
  customDomainVerifyToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pages       Page[]
  media       Media[]
  theme       Theme?
  savedBlocks SavedBlock[]
  memberships Membership[]
  invitations Invitation[]
  collections Collection[]
  templates   Template[]
  settings    SiteSettings?
}

// Site-level settings/secrets store (docs/integrations.md "Shared plumbing
// this implies") — one row per Site, holding whatever cross-cutting
// integration config exists so far. Each integration gets its own nullable
// Json field here rather than a new sibling table per integration.
model SiteSettings {
  id           String   @id @default(uuid())
  siteId       String   @unique
  cookieBanner Json?
  newsletter   Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

enum MembershipRole {
  OWNER
  EDITOR
  VIEWER
}

model Membership {
  id        String         @id @default(uuid())
  siteId    String
  userId    String
  role      MembershipRole
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
}

model Invitation {
  id         String         @id @default(uuid())
  siteId     String
  email      String
  role       MembershipRole
  token      String         @unique
  createdAt  DateTime       @default(now())
  acceptedAt DateTime?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Theme {
  id        String   @id @default(uuid())
  siteId    String   @unique
  tokens    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model SavedBlock {
  id        String   @id @default(uuid())
  siteId    String
  name      String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Media {
  id         String   @id @default(uuid())
  siteId     String
  url        String
  storageKey String
  mimeType   String
  width      Int?
  height     Int?
  altText    String?
  createdAt  DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Page {
  id               String   @id @default(uuid())
  siteId           String
  slug             String
  title            String
  draftContent     Json
  publishedContent Json?
  isHome           Boolean  @default(false)
  // Set for a dynamic/repeater page: the block tree above is the template,
  // rendered once per CollectionItem (see docs/collections.md).
  collectionId     String?
  // Page-tree hierarchy, independent of `slug` (see docs/content-import.md
  // "Page hierarchy: decision") — the renderer never reads this, it only
  // resolves `slug` directly. Null for manually-created pages (flat,
  // top-level); sitemap import is the natural first writer of it.
  parentId         String?
  // Per-page SEO fields (docs/integrations.md "SEO"): meta title/description,
  // canonical URL, OG/Twitter fields, robots index/follow. Kept as one Json
  // blob (PageSeo, lib/seo.ts) rather than discrete columns since these are
  // all optional and only ever read/written together.
  seo              Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site            Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  collection      Collection?      @relation(fields: [collectionId], references: [id])
  parent          Page?            @relation("PageHierarchy", fields: [parentId], references: [id])
  children        Page[]           @relation("PageHierarchy")
  revisions       Revision[]
  formSubmissions FormSubmission[]

  @@unique([siteId, slug])
}

model FormSubmission {
  id        String   @id @default(uuid())
  pageId    String
  blockId   String
  data      Json
  createdAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Collection {
  id         String   @id @default(uuid())
  siteId     String
  name       String
  fieldSchema Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  site  Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items CollectionItem[]
  pages Page[]
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String
  data         Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

enum TemplateType {
  header
  footer
  pageTemplate
  collectionItemTemplate
  popup
}

model Template {
  id        String       @id @default(uuid())
  siteId    String
  type      TemplateType
  name      String
  content   Json
  condition Json
  // Popup-only: PopupTrigger + frequency/close-behavior settings
  // (lib/popupTrigger.ts). Null for non-popup template types.
  trigger   Json?
  priority  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Revision {
  id          String   @id @default(uuid())
  pageId      String
  content     Json
  createdById String
  createdAt   DateTime @default(now())
  label       String?

  page      Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
}
