# Postgres connection string used by Prisma
DATABASE_URL="postgresql://opensite:opensite@localhost:5432/opensite?schema=public"

# Random 32+ char secret used to sign NextAuth session tokens
# generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Base URL this app is served from (used by NextAuth for callbacks)
NEXTAUTH_URL="http://localhost:3000"

# Base domain that site subdomains are minted under, e.g. sites.example.com
# so a Site with subdomain "acme" is served at acme.sites.example.com.
# Leave unset in local dev and use the /site/[subdomain]/... path fallback
# instead (see lib/resolveSite.ts).
APP_DOMAIN=""

# Local path media uploads would be written to (media upload isn't built in
# Phase 0, but the volume/env var is wired up ahead of it).
MEDIA_STORAGE_PATH="/data/media"

# Custom domains: once a site owner adds and DNS-verifies a custom domain
# (dashboard Settings → Custom domain), point that domain's DNS (A/CNAME) at
# this server. In production, run the optional `caddy` service (`docker
# compose --profile proxy up`) in front of `web` — it issues Let's Encrypt
# certs on demand for verified domains via /api/domains/verify-ask. See
# Caddyfile and docs/deployment.md.

# Key used to encrypt secrets at rest (currently: AI Mode site-level
# provider API keys, lib/secrets.ts). Any string works — it's stretched to
# 32 bytes via SHA-256, so a random passphrase is fine.
# generate one with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=""

# Instance-level whitelabeling (docs/ai-mode.md) — applied to the dashboard
# shell and login/signup pages only, never to published sites. All optional;
# unset falls back to "OpenSite Studio" branding.
APP_NAME=""
APP_LOGO_URL=""
APP_FAVICON_URL=""
APP_PRIMARY_COLOR=""

# Absolute path to the /plugins directory (docs/plugin-sdk.md) scanned at
# server startup. Optional — defaults to a "plugins" directory two levels
# up from apps/web (i.e. next to /apps at the repo root, or /app/plugins in
# the Docker image; see docker-compose.yml's bind mount). Only set this if
# your deployment's layout doesn't match that default.
PLUGINS_DIR=""

# Anthropic key used by "generate site copy" (docs/ai-mode.md's generation
# section). Optional: a site with its own AI provider key configured in its
# AI settings uses that instead, and this is the fallback for sites that
# don't. Without either, the generate button reports that no key is set.
ANTHROPIC_API_KEY=""
